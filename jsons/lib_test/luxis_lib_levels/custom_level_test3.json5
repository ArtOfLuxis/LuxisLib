        "ZombieSpeedEvent"
      ],
      "objclass": "LLExecuteActions",
      "objdata": {
        "Actions": [{
          "kind": "InvokeJavaScript",
          "variables": {
            "zombiePool": { "kind": "GetZombiePoolArray" },
            "Math": { "kind": "GetMath" }
          },
          "code": '\
                  zombiePool.forEach(zombie => {\
                    zombie.potionSpeedLevel = Math.max(3, zombie.potionSpeedLevel + 1) \
                  })\
                ',
        }]
      }
