{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvzge.com/jsons/schema/gpn-worldmap.schema.json",
  "title": "Luxis Lib Worldmap JSON",
  "description": "Schema for Luxis Lib runtime world-map replacement patches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "worlds"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": 1,
      "description": "Worldmap JSON API version. Current format is version 1. worldmap JSON 的 API 版本；当前格式为第 1 版。"
    },
    "worlds": {
      "type": "object",
      "description": "Map keyed by world CODENAME. 以世界 CODENAME 为键的对象。",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/worldPatch"
      }
    }
  },
  "$defs": {
    "worldPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/worldData"
        },
        "map": {
          "$ref": "#/$defs/mapSpec"
        },
        "endless": {
          "$ref": "#/$defs/endlessSpec"
        }
      }
    },
    "worldData": {
      "type": "object",
      "additionalProperties": false,
      "description": "World-level data overrides. 世界级数据覆盖。",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Override LEVELS. 覆盖 LEVELS。"
        },
        "plants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Override PLANTS. 覆盖 PLANTS。"
        },
        "startingLevels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Override STARTINGLEVELS. 覆盖 STARTINGLEVELS。"
        },
        "epicTarget": {
          "type": "string",
          "description": "Override EPIC_TARGET. 覆盖 EPIC_TARGET。"
        },
        "intro": {
          "type": "string",
          "description": "Override INTRO. 覆盖 INTRO。"
        }
      }
    },
    "mapSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mainline"
      ],
      "properties": {
        "mode": {
          "const": "replace",
          "description": "Replace the runtime graph completely. 完全替代运行时地图图结构。"
        },
        "reuseOriginalPositions": {
          "type": "boolean",
          "description": "When a mainline node omits `position`, reuse the original world mainline position at the same mainline array index. 当主线节点未写 `position` 时，复用原地图主线中相同主线数组下标的位置。"
        },
        "overlapThreshold": {
          "type": "number",
          "description": "Warn if nodes are closer than this distance. 节点距离小于该值时给出重叠警告。"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Scale of the world map islands and level nodes. Defaults to 1."
        },
        "autoLayout": {
          "$ref": "#/$defs/autoLayout"
        },
        "mainline": {
          "type": "array",
          "description": "Ordered mainline node list. Array order defines the main progression automatically. 有序主线节点列表；数组顺序自动定义主线推进。",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeSpec"
          }
        },
        "branches": {
          "type": "array",
          "description": "Optional side-branch node list. Branch nodes are connected through `children` refs. 可选支线节点列表；支线通过 `children` 引用连接。",
          "items": {
            "$ref": "#/$defs/nodeSpec"
          }
        }
      }
    },
    "autoLayout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fallback layout settings",
      "properties": {
        "baseX": {
          "type": "number",
          "description": "Fallback base X."
        },
        "baseY": {
          "type": "number",
          "description": "Fallback base Y"
        },
        "xStep": {
          "type": "number",
          "description": "Horizontal spacing, default 250"
        },
        "yStep": {
          "type": "number",
          "description": "Vertical spacing, default 180"
        },
        "branchXStep": {
          "type": "number",
          "description": "Horizontal spacing for branches, default 200"
        },
        "branchYStep": {
          "type": "number",
          "description": "Vertical spacing for branches, default 130"
        },
        "ySmoothness": {
          "type": "number",
          "description": "Smoothness of vertical spacing, default 4"
        },
      }
    },
    "nodeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable node id used by children refs. 供 children 引用的稳定节点 id。"
        },
        "type": {
          "type": "string",
          "enum": [
            "level",
            "plant",
            "giftBox",
            "upgrade",
            "epicPortal"
          ],
          "description": "Runtime island type. 运行时节点类型。"
        },
        "appearance": {
          "type": "string",
          "enum": [
            "normal",
            "minigame",
            "gargantuar",
            "zomboss"
          ],
          "description": "Level-node appearance for type=level. Use gargantuar for 'small boss' / giant-island style stages. level 类型节点的外观类别；“小 Boss”/巨人岛风格关卡用 gargantuar。"
        },
        "title": {
          "type": "string",
          "description": "Visible node title / label. 节点上显示的标题文字。"
        },
        "template": {
          "$ref": "#/$defs/templateSelector",
          "description": "Template selector used when cloning island visuals/components. String references support `world:templateId`; without a namespace, the current world is used. Plant nodes can select templates by island ID or displayed plant codename, or by using an object selector with plantDisplayed."
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "relativePosition": {
          "$ref": "#/$defs/positionOffset"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Level ids for level nodes"
        },
        "portalLevels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Epic level ids for epicPortal nodes. epicPortal 节点对应的史诗关卡 id 列表。"
        },
        "plantReward": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Plant reward for plant nodes. plant 节点的植物奖励。"
        },
        "upgradeReward": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Upgrade reward for upgrade nodes. upgrade 节点的升级奖励。"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional child node ids. For `mainline`, GP-Next auto-links the next mainline item before these declared children. 额外子节点 id 列表；对于 `mainline`，GP-Next 会先自动连接下一项主线，再追加这里声明的子节点。"
        },
        "siblingIndex": {
          "type": "integer",
          "description": "Sibling order of this island node, independent of its local Z coordinate."
        },
        "warnOverlap": {
          "type": "boolean",
          "description": "Enable overlap warning for this node. 是否为该节点启用重叠警告。"
        },
        "overlapThreshold": {
          "type": "number",
          "description": "Per-node overlap warning distance. 当前节点自己的重叠警告距离。"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "position",
              "relativePosition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "level"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "levels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "plant"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "plantReward"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "upgrade"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "upgradeReward"
            ]
          }
        }
      ]
    },
    "endlessSpec": {
      "oneOf": [
        {
          "type": "array",
          "description": "Legacy shorthand for endless-zone definitions.",
          "items": {
            "$ref": "#/$defs/endlessNodeSpec"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes"
          ],
          "properties": {
            "keepOriginal": {
              "type": "boolean",
              "default": true,
              "description": "Keep original endless zones that weren't selected as templates."
            },
            "nodes": {
              "type": "array",
              "description": "Endless-zone entrances to create.",
              "items": {
                "$ref": "#/$defs/endlessNodeSpec"
              }
            }
          }
        }
      ]
    },
    "endlessNodeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "template",
        "levels",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node name for the endless-zone entrance."
        },
        "template": {
          "$ref": "#/$defs/endlessTemplateSelector"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Level IDs passed to KeyListener.goToLevel."
        },
        "endlessData": {
          "type": "string",
          "description": "WorldMapSceneDisplayEnum key used to load danger-room data."
        },
        "isMiniGame": {
          "type": "boolean",
          "description": "Whether the entrance uses endless minigame data."
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "siblingIndex": {
          "type": "integer",
          "description": "Sibling order of the entrance node."
        },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["string", "number"]
              },
              "description": "Localized endless-zone name."
            },
            "levelNumber": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["string", "number"]
              },
              "description": "Localized level number text. Supports the {level} placeholder."
            }
          }
        }
      }
    },
    "endlessTemplateSelector": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:]+(:[^:]+)?$",
          "description": "Template ID, optionally prefixed with a world CODENAME. For plant islands, the ID can also be the displayed plant codename. Examples: `modern2`, `egypt:egypt2`, `egypt:peashooter`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "id": {
              "type": "string",
              "description": "Exact endless entrance node name."
            },
            "levelId": {
              "type": "string",
              "description": "Match an entrance containing this level ID."
            },
            "levelIds": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Match an entrance containing every listed level ID."
            },
            "endlessData": {
              "type": "string",
              "description": "Match the endless world's enum key."
            },
            "isMiniGame": {
              "type": "boolean",
              "description": "Match whether the entrance is a minigame."
            }
          }
        }
      ]
    },
    "templateSelector": {
      "description": "Selector used when cloning from existing runtime nodes. String references support `world:levelId`, where `world` is a world CODENAME and `levelId` is the template's level ID. Without a namespace, the current world is used. Object selectors match templates in the current world only.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Match by stable runtime/custom id."
            },
            "customId": {
              "type": "string",
              "description": "Match by GP-Next custom id."
            },
            "levelId": {
              "type": "string",
              "description": "Match a level island by ordinary levelJsonsID or endless entrance levelsID."
            },
            "levelIds": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ],
              "description": "Match a level island by all listed ordinary/endless level IDs."
            },
            "portalLevelId": {
              "type": "string",
              "description": "Match an epic portal by one represented epic level ID."
            },
            "portalLevelIds": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ],
              "description": "Match an epic portal by all represented epic level IDs."
            },
            "type": {
              "type": "string",
              "enum": [
                "level",
                "plant",
                "giftBox",
                "upgrade",
                "epicPortal"
              ],
              "description": "Match by runtime island type."
            },
            "appearance": {
              "type": "string",
              "enum": [
                "normal",
                "minigame",
                "gargantuar",
                "zomboss"
              ],
              "description": "Match by level-node appearance family."
            },
            "plantDisplayed": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "description": "Match a plant node by displayed reward."
            },
            "upgradeDisplayed": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "description": "Match an upgrade node by displayed reward."
            }
          },
          "minProperties": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:]+(:[^:]+)?$",
          "description": "Template level ID, optionally prefixed with a world CODENAME. Examples: `modern2`, `egypt:egypt2`, `future:future5`."
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "description": "Local X position"
        },
        "y": {
          "type": "number",
          "description": "Local Y position"
        },
        "z": {
          "type": "number",
          "description": "Local Z position"
        }
      }
    },
    "positionOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "description": "Offset relative to the resolved parent node position.",
      "properties": {
        "x": {
          "type": "number",
          "description": "Relative X offset"
        },
        "y": {
          "type": "number",
          "description": "Relative Y offset"
        },
        "z": {
          "type": "number",
          "description": "Relative Z offset"
        }
      }
    },
  }
}